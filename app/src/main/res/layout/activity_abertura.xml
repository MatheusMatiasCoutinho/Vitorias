<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vitorias_fundo"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- Palavras de abertura -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/abertura_protecao"
        android:textColor="@color/vitorias_malva_escuro"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/abertura_liberdade"
        android:textColor="@color/vitorias_malva_claro"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/abertura_dignidade"
        android:textColor="@color/vitorias_malva_escuro"
        android:textSize="30sp"
        android:textStyle="bold" />

    <!-- Logo -->
    <ImageView
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginTop="32dp"
        android:contentDescription="@null"
        android:src="@drawable/logo" />

    <!-- Botão VITÓRIAS -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEntrar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="40dp"
        android:backgroundTint="@color/vitorias_roxo"
        android:letterSpacing="0.05"
        android:text="@string/abertura_entrar"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="26sp"
        android:textStyle="bold"
        app:cornerRadius="6dp" />

</LinearLayout>