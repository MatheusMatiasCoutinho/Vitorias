<?xml version="1.0" encoding="utf-8"?>
<!-- Barra inferior: compartilhada por todas as telas via <include> -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:orientation="vertical">

    <!-- Linha divisória -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/vitorias_divisoria" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/navDenuncia"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/nav_denuncia"
            android:textColor="@color/vitorias_nav_inativo"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/navApoio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/nav_apoio"
            android:textColor="@color/vitorias_nav_inativo"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/navEmergencia"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/nav_emergencia"
            android:textColor="@color/vitorias_nav_inativo"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>