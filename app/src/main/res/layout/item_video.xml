<?xml version="1.0" encoding="utf-8"?>
<!-- Card de um vídeo do carrossel. O ViewPager2 exige raiz em match_parent. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="24dp"
    android:paddingVertical="8dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:foreground="?attr/selectableItemBackground"
        app:cardCornerRadius="24dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp">

        <!-- Miniatura do YouTube; a cor de fundo aparece enquanto carrega -->
        <ImageView
            android:id="@+id/imgMiniatura"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/vitorias_malva_claro"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <!-- Ícone de play por cima -->
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_play_circle" />

    </com.google.android.material.card.MaterialCardView>
</FrameLayout>