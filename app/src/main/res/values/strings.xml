    <string name="violencia_patrimonial_desc">Conduta que retenha, subtraia ou destrua objetos, documentos, bens, valores ou recursos econômicos da mulher.</string>
    <string name="violencia_sexual">Sexual</string>
    <string name="violencia_sexual_desc">Conduta que force a mulher a presenciar, manter ou participar de relação sexual não desejada, por intimidação, ameaça, coação ou uso da força.</string>
    <string name="violencia_moral">Moral</string>
    <string name="violencia_moral_desc">Conduta que configure calúnia, difamação ou injúria contra a mulher.</string>


